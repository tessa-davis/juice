resource "aws_security_group" "snyk_rds_sg" {
  name   = "snyk_demo_rds_sg"
  vpc_id = var.vpc_id

  tags = {
    Name      = "snyk_demo_rds_sg"
    yor_trace = "95206061-ddd1-45bd-987a-d0c0744414d8"
  }

  # HTTP access from anywhere
  ingress {
    from_port   = 5432
    to_port     = 5432
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  # outbound internet access
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}
